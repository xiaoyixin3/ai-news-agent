# true = 显式离线演示；false = 真实 DeepSeek Agent，绝不自动降级
DEMO_MODE=true
PORT=8080
DATA_DIR=./data
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 根据官方工具调用文档选用；可以改成账号支持的其他模型
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
MAX_ROUNDS=16
MAX_TOOL_CALLS=40
RUN_TIMEOUT=300
SCHEDULER_ENABLED=true
# 可选邮件：TLS 方式 starttls / ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

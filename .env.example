# true = 显式离线演示；false = 真实 DeepSeek Agent，绝不自动降级
DEMO_MODE=true
PORT=8080
DATA_DIR=./data
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 根据官方工具调用文档选用；可以改成账号支持的其他模型
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
MAX_ROUNDS=16
MAX_TOOL_CALLS=40
RUN_TIMEOUT=300
CONTEXT_TOKEN_LIMIT=24000
RUN_TOKEN_LIMIT=100000
NETWORK_BYTE_LIMIT=20971520
WORKSPACE_BYTE_LIMIT=10485760
# 新闻网络：默认系统 DNS 与直连；受限网络可显式选择 cloudflare 和本机 SOCKS 代理
NEWS_DNS_MODE=system
# 例如 socks5://127.0.0.1:7897；仅允许本机无认证端口，代理收到已验证的数字 IP
NEWS_SOCKS_PROXY=
DELIVERY_RETRY_COOLDOWN=30
SCHEDULER_ENABLED=true
# 真实 shell：默认 Windows PowerShell 或 Linux /bin/bash，只接受 pwd/ls
# Linux 需要 /usr/bin/setsid；仅管理员可配置可信 shell 的绝对路径
# SHELL_EXECUTABLE=C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
SHELL_TIMEOUT_MS=5000
# 可选邮件：TLS 方式 starttls / ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
